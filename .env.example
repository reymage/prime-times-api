# ── Core ──────────────────────────────────────────────────────────────────────
# Local dev: postgres://user:password@localhost:5432/dbname
# Docker: handled automatically by docker-compose.yml (do not set here for Docker)
DATABASE_URL=postgres://ptd_user:your_local_password@localhost:5432/ptd

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-64-character-random-hex-string

# development | production
ENVIRONMENT=development

# ── Security ──────────────────────────────────────────────────────────────────
# JSON array of allowed CORS origins
CORS_ORIGINS=["http://localhost:5173"]

# JSON array of allowed Host header values — use ["*"] for dev only
ALLOWED_HOSTS=["*"]

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_DEFAULT=100/minute

# ── Docker / production only (not used for local dev) ─────────────────────────
POSTGRES_DB=ptd
POSTGRES_USER=ptd_user
POSTGRES_PASSWORD=replace-with-a-strong-random-password
GUNICORN_WORKERS=4
