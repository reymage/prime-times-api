# ── Core ──────────────────────────────────────────────────────────────────────
# Local dev: postgres://user:password@localhost:5432/dbname
# Docker: handled automatically by docker-compose.yml (do not set here for Docker)
# DATABASE_URL=postgres://ptd_user:your_local_password@localhost:5432/ptd
DATABASE_URL=postgresql://postgres.xecqljcxyoqdnhqndrvd:_08055614709IMcm@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-64-character-random-hex-string

# development | production
ENVIRONMENT=development

# ── Security ──────────────────────────────────────────────────────────────────
# JSON array of allowed CORS origins
CORS_ORIGINS=["http://localhost:5173"]

# JSON array of allowed Host header values — use ["*"] for dev only
ALLOWED_HOSTS=["*"]

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_DEFAULT=100/minute

# ── JWT ───────────────────────────────────────────────────────────────────────
# How long access tokens last (seconds). Default: 3600 (1 hour)
ACCESS_TOKEN_EXPIRE_SECONDS=3600

# ── Frontend ──────────────────────────────────────────────────────────────────
# Base URL of the frontend — used to construct email links
FRONTEND_URL=http://localhost:5173

# ── Cloudflare edge cache (purge-on-publish) ────────────────────────────────────
# Purges the public site's edge cache the moment a story is published/edited so
# breaking news appears instantly. The API token needs the "Cache Purge" permission.
# Leave the IDs blank to disable purging. PUBLIC_SITE_URL falls back to FRONTEND_URL.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
PUBLIC_SITE_URL=https://wire24news.pages.dev

# ── Email ─────────────────────────────────────────────────────────────────────
# console  →  print to stdout (default — no credentials needed for dev)
# brevo    →  send via Brevo transactional email API
EMAIL_PROVIDER=console

# Brevo — fill in when EMAIL_PROVIDER=brevo
# Get your API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=noreply@primetimesdaily.com
EMAIL_FROM_NAME=Prime Times Daily

# ── AI / LLM ──────────────────────────────────────────────────────────────────
# groq | openai | anthropic
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI (set LLM_PROVIDER=openai to use)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (set LLM_PROVIDER=anthropic to use)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# ── Tavily ────────────────────────────────────────────────────────────────────
TAVILY_API_KEY=

# ── Prompts ───────────────────────────────────────────────────────────────────
# Relative to the api/ working directory
PROMPTS_DIR=prompts

# ── Cache ─────────────────────────────────────────────────────────────────────
# Leave empty to use in-memory LRU (single-instance dev)
# Set to redis://localhost:6379 for multi-instance / production
REDIS_URL=
CACHE_TTL_SECONDS=3600

# ── AI rate limiting ──────────────────────────────────────────────────────────
AI_RATE_LIMIT=10
AI_RATE_LIMIT_WINDOW=60

# ── Docker / production only (not used for local dev) ─────────────────────────
POSTGRES_DB=ptd
POSTGRES_USER=ptd_user
POSTGRES_PASSWORD=replace-with-a-strong-random-password
GUNICORN_WORKERS=4
